# ==============================================================================
# RentTogether — Environment Configuration Template
# Duplicate this file to backend/.env and customize with your credentials
# ==============================================================================

# Django Security
SECRET_KEY=django-insecure-change-this-in-production-renttogether-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Neon PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# If left empty, defaults to local SQLite for frictionless local testing.
DATABASE_URL=

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis & Celery (Background Jobs & Cache)
REDIS_URL=redis://localhost:6379/0

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

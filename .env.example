# ==============================================================================
# RentTogether — Environment Configuration Template
# Duplicate this file to backend/.env and customize with your credentials
# ==============================================================================

# Django Security
SECRET_KEY=django-insecure-change-this-in-production-renttogether-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,renttogether.onrender.com,.onrender.com
FRONTEND_URL=https://renttogether.vercel.app
BACKEND_URL=https://renttogether.onrender.com

# Database Configuration (Neon PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# If left empty, defaults to local SQLite for frictionless local testing.
DATABASE_URL=

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis & Celery (Background Jobs & Cache)
REDIS_URL=redis://localhost:6379/0

# SMTP / Institutional Email Delivery
# Leave empty to print OTP / notification emails to console for local testing.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RentTogether <noreply@renttogether.edu>

# CORS & CSRF Configuration (Vercel Frontend <-> Render Backend)
CORS_ALLOWED_ORIGINS=https://renttogether.vercel.app,https://renttogether.onrender.com,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://renttogether.vercel.app,https://renttogether.onrender.com,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

